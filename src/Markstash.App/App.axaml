<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="using:FluentAvalonia.Styling"
             xmlns:viewModels="using:Markstash.App.ViewModels"
             xmlns:views="using:Markstash.App.Views"
             x:Class="Markstash.App.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <DataTemplate DataType="viewModels:HomePageViewModel">
      <views:HomePageView />
    </DataTemplate>
    <DataTemplate DataType="viewModels:LibraryPageViewModel">
      <views:LibraryPageView />
    </DataTemplate>
    <DataTemplate DataType="viewModels:SearchPageViewModel">
      <views:SearchPageView />
    </DataTemplate>
    <DataTemplate DataType="viewModels:SettingsPageViewModel">
      <views:SettingsPageView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <styling:FluentAvaloniaTheme PreferSystemTheme="True"
                                  PreferUserAccentColor="True" />

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.surface">
      <Setter Property="Background" Value="#0F808080" />
      <Setter Property="BorderBrush" Value="#30808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18" />
    </Style>
  </Application.Styles>
</Application>
