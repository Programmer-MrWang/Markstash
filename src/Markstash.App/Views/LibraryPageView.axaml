<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="using:Markstash.App.Localization"
             xmlns:viewModels="using:Markstash.App.ViewModels"
             x:Class="Markstash.App.Views.LibraryPageView"
             x:DataType="viewModels:LibraryPageViewModel">
  <Grid RowDefinitions="Auto,*" Margin="28">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Classes="page-title" Text="{Binding Title}" />
        <TextBlock Opacity="0.68" Text="{Binding ItemCountText}" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="{x:Static localization:AppStrings.LibraryNew}"
              VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1"
            Classes="surface"
            Margin="0,24,0,0"
            MinHeight="260">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10">
        <TextBlock FontSize="20"
                   FontWeight="SemiBold"
                   Text="{x:Static localization:AppStrings.LibraryEmptyTitle}" />
        <TextBlock MaxWidth="360"
                   Opacity="0.68"
                   Text="{x:Static localization:AppStrings.LibraryEmptyDescription}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
