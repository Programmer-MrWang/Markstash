<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:Markstash.App.ViewModels"
             x:Class="Markstash.App.Views.SearchPageView"
             x:DataType="viewModels:SearchPageViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="28">
    <TextBlock Classes="page-title" Text="{Binding Title}" />

    <TextBox Grid.Row="1"
             Margin="0,22,0,0"
             MaxWidth="760"
             HorizontalAlignment="Stretch"
             Text="{Binding Query, Mode=TwoWay}"
             PlaceholderText="搜索收藏、笔记和文件" />

    <Border Grid.Row="2"
            Classes="surface"
            Margin="0,18,0,0"
            MinHeight="220">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="输入关键词开始搜索" />
        <TextBlock Opacity="0.68" Text="索引实现将通过 Application 层接入。" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
