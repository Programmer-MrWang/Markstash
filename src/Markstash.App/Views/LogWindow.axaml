<windowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:fa="using:FluentAvalonia.UI.Controls"
                       xmlns:localization="using:Markstash.App.Localization"
                       xmlns:viewModels="using:Markstash.App.ViewModels"
                       xmlns:windowing="using:FluentAvalonia.UI.Windowing"
                       x:Class="Markstash.App.Views.LogWindow"
                       x:DataType="viewModels:LogWindowViewModel"
                       Width="1120"
                       Height="640"
                       MinWidth="760"
                       MinHeight="460"
                       Title="{x:Static localization:AppStrings.LogWindowTitle}"
                       WindowStartupLocation="CenterOwner">
  <Grid Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
        RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0"
          Margin="16,14,16,10"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="16">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ToggleButton Content="{x:Static localization:AppStrings.LogLevelCritical}"
                        IsChecked="{Binding IncludeCritical, Mode=TwoWay}" />
          <ToggleButton Content="{x:Static localization:AppStrings.LogLevelError}"
                        IsChecked="{Binding IncludeError, Mode=TwoWay}" />
          <ToggleButton Content="{x:Static localization:AppStrings.LogLevelWarning}"
                        IsChecked="{Binding IncludeWarning, Mode=TwoWay}" />
          <ToggleButton Content="{x:Static localization:AppStrings.LogLevelInformation}"
                        IsChecked="{Binding IncludeInformation, Mode=TwoWay}" />
          <ToggleButton Content="{x:Static localization:AppStrings.LogLevelDebug}"
                        IsChecked="{Binding IncludeDebug, Mode=TwoWay}" />
          <ToggleButton Content="{x:Static localization:AppStrings.LogLevelTrace}"
                        IsChecked="{Binding IncludeTrace, Mode=TwoWay}" />
        </StackPanel>
      </ScrollViewer>

      <TextBox Grid.Column="1"
               Width="240"
               Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="{x:Static localization:AppStrings.LogSearchPlaceholder}" />
    </Grid>

    <DataGrid x:Name="LogGrid"
              Grid.Row="1"
              Margin="16,0"
              AutoGenerateColumns="False"
              Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
              CanUserReorderColumns="True"
              GridLinesVisibility="Horizontal"
              IsReadOnly="True"
              ItemsSource="{Binding Entries}"
              SelectionMode="Extended">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="{x:Static localization:AppStrings.LogColumnTime}"
                                Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="viewModels:LogEntryRowViewModel">
              <TextBlock Margin="8,7"
                         Text="{Binding TimestampText}"
                         VerticalAlignment="Top" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static localization:AppStrings.LogColumnLevel}"
                                Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="viewModels:LogEntryRowViewModel">
              <Border Margin="6"
                      Padding="8,3"
                      Background="{Binding LevelBackground}"
                      CornerRadius="4">
                <TextBlock Text="{Binding LevelText}" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static localization:AppStrings.LogColumnCategory}"
                                MaxWidth="280"
                                Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="viewModels:LogEntryRowViewModel">
              <SelectableTextBlock Margin="8,7"
                                   Text="{Binding Category}"
                                   TextWrapping="Wrap" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static localization:AppStrings.LogColumnMessage}"
                                Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="viewModels:LogEntryRowViewModel">
              <SelectableTextBlock Margin="8,7"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="2"
          Margin="16,10,16,14"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="16">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding EntryCountText}" />
        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding StatusText}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Click="OnRefreshClick"
                ToolTip.Tip="{x:Static localization:AppStrings.LogRefresh}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <fa:FASymbolIcon Symbol="Refresh" />
            <TextBlock Text="{x:Static localization:AppStrings.LogRefresh}" />
          </StackPanel>
        </Button>
        <Button Click="OnCopySelectedClick"
                ToolTip.Tip="{x:Static localization:AppStrings.LogCopySelected}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <fa:FASymbolIcon Symbol="Copy" />
            <TextBlock Text="{x:Static localization:AppStrings.LogCopySelected}" />
          </StackPanel>
        </Button>
        <Button Click="OnOpenDirectoryClick"
                ToolTip.Tip="{x:Static localization:AppStrings.MenuOpenLogsDirectory}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <fa:FASymbolIcon Symbol="Folder" />
            <TextBlock Text="{x:Static localization:AppStrings.LogOpenDirectory}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</windowing:FAAppWindow>
