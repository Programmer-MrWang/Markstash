<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        miuix-blur declares API 33 because its shader path needs RuntimeShader.
        Android 12 uses the guarded compatibility renderer instead; no miuix-blur
        entry point is invoked below API 33.
    -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />
    <application
        android:name=".MarkstashApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/markstash"
        android:roundIcon="@drawable/markstash"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Markstash">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
